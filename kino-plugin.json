{
  "id": "maraton",
  "name": "PelisYSeries",
  "version": "0.9.2",
  "apiVersion": 30,
  "entry": "plugin.js",
  "description": "Series, anime y películas en latino, castellano o subtitulado. El video se busca en tu propio aparato, sin servidores intermedios.",
  "author": "Equipo PelisYSeries",
  "hosts": [
    "serieskao.top",
    "morencius.com",
    "sololatino.net",
    "hglink.to",
    "hlswish.com",
    "voe.sx",
    "allcalidad.re",
    "vimeos.net",
    "goodstream.one",
    "videoapp.zip",
    "filemoon.sx",
    "embed69.org"
  ],
  "fetchHosts": "any",
  "capabilities": [
    "search",
    "scopedSearch",
    "home",
    "browse",
    "episodes",
    "resolve",
    "meta",
    "download",
    "screen"
  ],
  "categories": [
    "series",
    "anime",
    "movies"
  ],
  "browser": "pages",
  "streamHosts": "any",
  "discoverable": true,
  "debug": false,
  "color": "#2E7D6B",
  "settings": [
    {
      "key": "sources",
      "label": "Sitios",
      "type": "section",
      "hint": "De dónde salen las series, el anime y las películas"
    },
    {
      "key": "useSerieskao",
      "label": "Usar SeriesKao",
      "type": "toggle",
      "default": true
    },
    {
      "key": "useAllcalidad",
      "label": "Usar AllCalidad",
      "type": "toggle",
      "default": true
    },
    {
      "key": "useSololatino",
      "label": "Usar SoloLatino",
      "type": "toggle",
      "default": true
    },
    {
      "key": "playback",
      "label": "Reproducción",
      "type": "section",
      "hint": "Cómo se elige el servidor de cada video"
    },
    {
      "key": "lang",
      "label": "Idioma preferido",
      "type": "select",
      "default": "lat",
      "options": [
        {
          "value": "lat",
          "label": "Latino"
        },
        {
          "value": "esp",
          "label": "Castellano"
        },
        {
          "value": "sub",
          "label": "Subtitulado"
        }
      ]
    },
    {
      "key": "server",
      "label": "Probar primero",
      "type": "select",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "El que funcionó la última vez"
        },
        {
          "value": "streamwish",
          "label": "Streamwish"
        },
        {
          "value": "voe",
          "label": "Voe"
        },
        {
          "value": "vidhide",
          "label": "Vidhide"
        },
        {
          "value": "vimeos",
          "label": "Vimeos"
        },
        {
          "value": "goodstream",
          "label": "Goodstream"
        }
      ]
    },
    {
      "key": "keepLinks",
      "label": "Recordar enlaces unas horas",
      "type": "toggle",
      "default": true,
      "hint": "Abre más rápido lo que ya viste hoy"
    },
    {
      "key": "tools",
      "label": "Estado",
      "type": "section"
    },
    {
      "key": "state",
      "label": "Estado",
      "type": "status"
    },
    {
      "key": "check",
      "label": "Revisar sitios",
      "type": "action"
    },
    {
      "key": "clear",
      "label": "Borrar enlaces guardados",
      "type": "action",
      "confirm": "¿Borrar los enlaces y servidores recordados?"
    }
  ],
  "icon": "icon.png",
  "homepage": "https://github.com/xuper-plugin/maraton",
  "section": {
    "label": "PelisYSeries"
  },
  "theme": {
    "accent": "#3FB08F",
    "onAccent": "#0B1F1A",
    "background": "#0B1613",
    "surface": "#14302A",
    "highlight": "#F2C14E"
  },
  "telemetry": true,
  "recommends": [
    "xuper-plugin/kino-plugin-kino-resolver"
  ],
  "signature": {
    "authorKey": "6693946bd5c56196960959c4b9665fad5094374bcb85ddb282f8bf762c835263",
    "value": "1376590a5e18f1d9472b1b25e3765b823569fa095592f56c03249f9f161530f052e94f26b4824f7eca1f7b1e40b992503866d5fb9b95c5aa9667065016e2ae01"
  },
  "screen": {
    "label": "PelisYSeries",
    "labelEn": "PelisYSeries",
    "icon": "movie",
    "menuOpens": "screen",
    "opensFrom": [
      "menu",
      "settings"
    ],
    "settingsButton": {
      "label": "Abrir PelisYSeries",
      "labelEn": "Open PelisYSeries"
    },
    "settingsIn": "screen"
  },
  "consumes": {
    "resolver": {
      "repo": "xuper-plugin/kino-plugin-kino-resolver",
      "door": "resolver",
      "calls": [
        "resolve"
      ]
    }
  }
}
