{
  "id": "maraton",
  "name": "Maratón",
  "version": "0.3.0",
  "apiVersion": 7,
  "entry": "plugin.js",
  "description": "Series, anime y películas en latino, castellano o subtitulado. El video se busca en tu propio aparato, sin servidores intermedios.",
  "author": "xuper-plugin",
  "hosts": [
    "serieskao.top",
    "sololatino.net",
    "morencius.com",
    "hglink.to",
    "voe.sx",
    "tmdb.allcalidad.re",
    "vimeos.net",
    "goodstream.one"
  ],
  "capabilities": [
    "search",
    "home",
    "browse",
    "episodes",
    "resolve",
    "meta",
    "download"
  ],
  "categories": [
    "series",
    "anime",
    "movies"
  ],
  "browser": true,
  "streamHosts": "any",
  "discoverable": true,
  "debug": false,
  "color": "#2E7D6B",
  "settings": [
    {
      "key": "lang",
      "label": "Idioma preferido",
      "type": "select",
      "default": "lat",
      "options": [
        {
          "value": "lat",
          "label": "Latino"
        },
        {
          "value": "esp",
          "label": "Castellano"
        },
        {
          "value": "sub",
          "label": "Subtitulado"
        }
      ]
    }
  ],
  "icon": "icon.png",
  "homepage": "https://github.com/xuper-plugin/maraton"
}
