{
  "id": "maraton",
  "name": "Maratón",
  "version": "0.1.5",
  "apiVersion": 7,
  "entry": "plugin.js",
  "description": "Series y anime de sitios web en español. Abre la página del episodio en un navegador oculto para encontrar el video.",
  "author": "xuper-plugin",
  "hosts": [
    "serieskao.top",
    "sololatino.net",
    "morencius.com",
    "hglink.to",
    "voe.sx"
  ],
  "capabilities": [
    "search",
    "home",
    "browse",
    "episodes",
    "resolve",
    "meta"
  ],
  "categories": [
    "series",
    "anime",
    "movies"
  ],
  "browser": true,
  "streamHosts": "any",
  "discoverable": false,
  "debug": false,
  "color": "#2E7D6B",
  "settings": [
    {
      "key": "lang",
      "label": "Idioma preferido",
      "type": "select",
      "default": "lat",
      "options": [
        {
          "value": "lat",
          "label": "Latino"
        },
        {
          "value": "esp",
          "label": "Castellano"
        },
        {
          "value": "sub",
          "label": "Subtitulado"
        }
      ]
    }
  ]
}
